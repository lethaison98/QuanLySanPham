@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    ViewData["Title"] = "Biểu đồ Tổng Số Sản Phẩm";
}

<div class="card">
    <div class="card-body">
        <h1 class="card-title">Biểu đồ Tổng Số Sản Phẩm</h1>
        <canvas id="totalProductsChart" width="400" height="200"></canvas>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    async function loadTotalProductChart() {
        const response = await fetch('/Product/GetTotalProductCount');
        const totalProductCount = await response.json();

        const ctx = document.getElementById('totalProductsChart').getContext('2d');
        new Chart(ctx, {
            type: 'pie', 
            data: {
                labels: ['Tổng Số Sản Phẩm'],
                datasets: [{
                    label: 'Số lượng sản phẩm',
                    data: [totalProductCount],
                    backgroundColor: ['rgba(75, 192, 192, 0.2)'],
                    borderColor: ['rgba(75, 192, 192, 1)'],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { position: 'top' }
                }
            }
        });
    }

    loadTotalProductChart();
</script>


@using QuanLySanPham.Application.ViewModel
@model PageViewModel<LoaiSanPhamViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Quản lý loại sản phẩm";
}

<h2 class="mt-4 mb-4 text-center">Danh Sách Loại Sản Phẩm</h2>

<!-- Nút Thêm Loại Sản Phẩm -->
<div class="mb-4 d-flex justify-content-end">
    <a href="@Url.Action("CreateLSP", "LoaiSanPham")" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Thêm Loại Sản Phẩm
    </a>
</div>

<!-- Form tìm kiếm -->
<form method="get" action="@Url.Action("DanhSachSP", "LoaiSanPham")" class="mb-4 d-flex justify-content-center">
    <div class="input-group w-50">
        <input type="text" name="keyword" class="form-control" placeholder="Nhập từ khóa tìm kiếm..." value="@Context.Request.Query["keyword"]" />
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    </div>
</form>

<!-- Bảng dữ liệu -->
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark text-center">
            <tr>
                <th>Tên Loại</th>
                <th>Mô Tả</th>
                <th>Ngày Tạo</th>
                <th>Ngày Cập Nhật</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Any())
            {
                @foreach (var loaiSanPham in Model.Items)
                {
                    <tr class="text-center">
                        <td>@loaiSanPham.TenLoai</td>
                        <td>@loaiSanPham.MoTa</td>
                        <td>@loaiSanPham.NgayTao.ToString("dd/MM/yyyy")</td>
                        <td>@(loaiSanPham.NgayCapNhat.HasValue ? loaiSanPham.NgayCapNhat.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật")</td>
                        <td>
                            <a href="@Url.Action("UpdateLSP", "LoaiSanPham", new { id = loaiSanPham.IdLoaiSanPham })" class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil-square"></i> Sửa
                            </a>
                            <a href="@Url.Action("DeleteLSP", "LoaiSanPham", new { id = loaiSanPham.IdLoaiSanPham })" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc chắn muốn xóa loại sản phẩm này không?');">
                                <i class="bi bi-trash"></i> Xóa
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">Không có loại sản phẩm nào được tìm thấy.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Phân trang -->
<nav aria-label="Pagination">
    <ul class="pagination justify-content-center">
        @for (var i = 1; i <= Math.Ceiling((double)Model.TotalRecord / Model.PageSize); i++)
        {
            <li class="page-item @(i == (Context.Request.Query["pageNumber"].Any() ? int.Parse(Context.Request.Query["pageNumber"]) : 1) ? "active" : "")">
                <a class="page-link" href="@Url.Action("DanhSachSP", "LoaiSanPham", new { pageNumber = i, pageSize = Model.PageSize, keyword = Context.Request.Query["keyword"] })">@i</a>
            </li>
        }
    </ul>
</nav>
